<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WindowsCalculatorMaui.ViewModels"
             x:Class="WindowsCalculatorMaui.Views.ScientificPage"
             x:DataType="vm:ScientificViewModel"
             Title="Scientific">

    <ContentPage.BindingContext>
        <vm:ScientificViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*"
          Padding="8,4,8,8"
          RowSpacing="0">

        <!-- Row 0: Title -->
        <Label Grid.Row="0"
               Text="Scientific"
               Style="{StaticResource PageTitleStyle}"
               Padding="4,10,4,4" />

        <!-- Row 1: Display -->
        <VerticalStackLayout Grid.Row="1" Spacing="0" Margin="4,4,4,4">
            <Label Text="{Binding ExpressionText}"
                   Style="{StaticResource DisplayExpressionStyle}"
                   MinimumHeightRequest="20" />
            <Label Text="{Binding DisplayText}"
                   Style="{StaticResource DisplaySciPrimaryStyle}" />
        </VerticalStackLayout>

        <!-- Row 2: DEG/RAD  |  F-E -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6" Margin="2,0,2,2">
            <Button Grid.Column="0" Text="{Binding AngleModeText}"
                    Style="{StaticResource AngleModeButtonStyle}"
                    Command="{Binding ToggleDegCommand}" />
            <Button Grid.Column="1" Text="F-E"
                    Style="{StaticResource AngleModeButtonStyle}"
                    Command="{Binding ToggleFeCommand}" />
        </Grid>

        <!-- Row 3: Memory -->
        <Grid Grid.Row="3"
              ColumnDefinitions="*,*,*,*,*,*"
              ColumnSpacing="2"
              Margin="2,0,2,2">
            <Button Grid.Column="0" Text="MC" Style="{StaticResource MemoryButtonStyle}"
                    Command="{Binding MemoryClearCommand}"    IsEnabled="{Binding HasMemory}" />
            <Button Grid.Column="1" Text="MR" Style="{StaticResource MemoryButtonStyle}"
                    Command="{Binding MemoryRecallCommand}"   IsEnabled="{Binding HasMemory}" />
            <Button Grid.Column="2" Text="M+" Style="{StaticResource MemoryButtonStyle}"
                    Command="{Binding MemoryAddCommand}" />
            <Button Grid.Column="3" Text="M−" Style="{StaticResource MemoryButtonStyle}"
                    Command="{Binding MemorySubtractCommand}" />
            <Button Grid.Column="4" Text="MS" Style="{StaticResource MemoryButtonStyle}"
                    Command="{Binding MemoryStoreCommand}" />
            <Button Grid.Column="5" Text="M∨" Style="{StaticResource MemoryButtonStyle}"
                    Command="{Binding MemoryViewCommand}"     IsEnabled="{Binding HasMemory}" />
        </Grid>

        <!-- Row 4: Trigonometry / Function dropdowns -->
        <Grid Grid.Row="4" ColumnDefinitions="*,*" ColumnSpacing="4" Margin="2,0,2,2">
            <Button Grid.Column="0" Text="△ Trigonometry ⌄"
                    Style="{StaticResource DropdownButtonStyle}"
                    Command="{Binding ToggleTrigCommand}" />
            <Button Grid.Column="1" Text="ƒ  Function ⌄"
                    Style="{StaticResource DropdownButtonStyle}"
                    Command="{Binding ToggleFuncCommand}" />
        </Grid>

        <!-- Row 5: Collapsible Trig / Func Panel -->
        <Grid Grid.Row="5">

            <!-- Trig panel: sin cos tan -->
            <Grid IsVisible="{Binding TrigVisible}"
                  ColumnDefinitions="*,*,*,*,*"
                  ColumnSpacing="4"
                  Margin="2,0,2,2">
                <Button Grid.Column="0"
                        Text="{Binding TrigSinText}"
                        Command="{Binding UnaryCommand}"
                        CommandParameter="{Binding TrigSinParam}"
                        Style="{StaticResource ScientificFunctionButtonStyle}" />
                <Button Grid.Column="1"
                        Text="{Binding TrigCosText}"
                        Command="{Binding UnaryCommand}"
                        CommandParameter="{Binding TrigCosParam}"
                        Style="{StaticResource ScientificFunctionButtonStyle}" />
                <Button Grid.Column="2"
                        Text="{Binding TrigTanText}"
                        Command="{Binding UnaryCommand}"
                        CommandParameter="{Binding TrigTanParam}"
                        Style="{StaticResource ScientificFunctionButtonStyle}" />
                <!-- cosh / sinh / tanh placeholders -->
                <Button Grid.Column="3" Text="cosh"
                        Command="{Binding UnaryCommand}" CommandParameter="cosh"
                        Style="{StaticResource ScientificFunctionButtonStyle}" />
                <Button Grid.Column="4" Text="sinh"
                        Command="{Binding UnaryCommand}" CommandParameter="sinh"
                        Style="{StaticResource ScientificFunctionButtonStyle}" />
            </Grid>

            <!-- Func panel: |x|  n!  floor  ceil  rand -->
            <Grid IsVisible="{Binding FuncVisible}"
                  ColumnDefinitions="*,*,*,*,*"
                  ColumnSpacing="4"
                  Margin="2,0,2,2">
                <Button Grid.Column="0" Text="|x|" Style="{StaticResource ScientificFunctionButtonStyle}"
                        Command="{Binding UnaryCommand}" CommandParameter="abs" />
                <Button Grid.Column="1" Text="n!" Style="{StaticResource ScientificFunctionButtonStyle}"
                        Command="{Binding UnaryCommand}" CommandParameter="fact" />
                <Button Grid.Column="2" Text="⌊x⌋" Style="{StaticResource ScientificFunctionButtonStyle}"
                        Command="{Binding UnaryCommand}" CommandParameter="floor" />
                <Button Grid.Column="3" Text="⌈x⌉" Style="{StaticResource ScientificFunctionButtonStyle}"
                        Command="{Binding UnaryCommand}" CommandParameter="ceil" />
                <Button Grid.Column="4" Text="exp" Style="{StaticResource ScientificFunctionButtonStyle}"
                        Command="{Binding OperationCommand}" CommandParameter="exp" />
            </Grid>
        </Grid>

        <!-- Row 6: Main Button Grid (7 rows × 5 cols) -->
        <Grid Grid.Row="6"
              RowDefinitions="*,*,*,*,*,*,*"
              ColumnDefinitions="*,*,*,*,*"
              RowSpacing="3"
              ColumnSpacing="3">

            <!-- Row 0: 2ⁿᵈ  π  e  C  ⌫ -->
            <Button Grid.Row="0" Grid.Column="0" Text="2ⁿᵈ"
                    Style="{StaticResource ScientificFunctionButtonStyle}"
                    BackgroundColor="{Binding Btn2ndBg}"
                    Command="{Binding ToggleSecondCommand}" />
            <Button Grid.Row="0" Grid.Column="1" Text="π"
                    Style="{StaticResource ScientificFunctionButtonStyle}"
                    Command="{Binding ConstantCommand}" CommandParameter="pi" />
            <Button Grid.Row="0" Grid.Column="2" Text="e"
                    Style="{StaticResource ScientificFunctionButtonStyle}"
                    Command="{Binding ConstantCommand}" CommandParameter="e" />
            <Button Grid.Row="0" Grid.Column="3" Text="C"
                    Style="{StaticResource OperatorButtonStyle}"
                    Command="{Binding ClearCommand}" />
            <Button Grid.Row="0" Grid.Column="4" Text="⌫"
                    Style="{StaticResource OperatorButtonStyle}"
                    Command="{Binding BackspaceCommand}" />

            <!-- Row 1: x²  1/x  |x|  exp  mod -->
            <Button Grid.Row="1" Grid.Column="0"
                    Text="{Binding BtnX2Text}"
                    Style="{StaticResource ScientificFunctionButtonStyle}"
                    Command="{Binding UnaryCommand}"
                    CommandParameter="{Binding BtnX2Param}" />
            <Button Grid.Row="1" Grid.Column="1" Text="¹/x"
                    Style="{StaticResource ScientificFunctionButtonStyle}"
                    Command="{Binding UnaryCommand}" CommandParameter="reciprocal" />
            <Button Grid.Row="1" Grid.Column="2" Text="|x|"
                    Style="{StaticResource ScientificFunctionButtonStyle}"
                    Command="{Binding UnaryCommand}" CommandParameter="abs" />
            <Button Grid.Row="1" Grid.Column="3" Text="exp"
                    Style="{StaticResource ScientificFunctionButtonStyle}"
                    Command="{Binding OperationCommand}" CommandParameter="exp" />
            <Button Grid.Row="1" Grid.Column="4" Text="mod"
                    Style="{StaticResource ScientificFunctionButtonStyle}"
                    Command="{Binding OperationCommand}" CommandParameter="mod" />

            <!-- Row 2: ²√x  (  )  n!  ÷ -->
            <Button Grid.Row="2" Grid.Column="0"
                    Text="{Binding BtnSqrtText}"
                    Style="{StaticResource ScientificFunctionButtonStyle}"
                    Command="{Binding UnaryCommand}"
                    CommandParameter="{Binding BtnSqrtParam}" />
            <Button Grid.Row="2" Grid.Column="1" Text="("
                    Style="{StaticResource ScientificFunctionButtonStyle}"
                    Command="{Binding OpenParenCommand}" />
            <Button Grid.Row="2" Grid.Column="2" Text=")"
                    Style="{StaticResource ScientificFunctionButtonStyle}"
                    Command="{Binding CloseParenCommand}" />
            <Button Grid.Row="2" Grid.Column="3" Text="n!"
                    Style="{StaticResource ScientificFunctionButtonStyle}"
                    Command="{Binding UnaryCommand}" CommandParameter="fact" />
            <Button Grid.Row="2" Grid.Column="4" Text="÷"
                    Style="{StaticResource OperatorButtonStyle}"
                    Command="{Binding OperationCommand}" CommandParameter="/" />

            <!-- Row 3: xʸ  7  8  9  × -->
            <Button Grid.Row="3" Grid.Column="0"
                    Text="{Binding BtnPowText}"
                    Style="{StaticResource ScientificFunctionButtonStyle}"
                    Command="{Binding OperationCommand}"
                    CommandParameter="{Binding BtnPowParam}" />
            <Button Grid.Row="3" Grid.Column="1" Text="7"
                    Style="{StaticResource NumberButtonStyle}"
                    Command="{Binding InputDigitCommand}" CommandParameter="7" />
            <Button Grid.Row="3" Grid.Column="2" Text="8"
                    Style="{StaticResource NumberButtonStyle}"
                    Command="{Binding InputDigitCommand}" CommandParameter="8" />
            <Button Grid.Row="3" Grid.Column="3" Text="9"
                    Style="{StaticResource NumberButtonStyle}"
                    Command="{Binding InputDigitCommand}" CommandParameter="9" />
            <Button Grid.Row="3" Grid.Column="4" Text="×"
                    Style="{StaticResource OperatorButtonStyle}"
                    Command="{Binding OperationCommand}" CommandParameter="*" />

            <!-- Row 4: 10ˣ  4  5  6  − -->
            <Button Grid.Row="4" Grid.Column="0"
                    Text="{Binding BtnPow10Text}"
                    Style="{StaticResource ScientificFunctionButtonStyle}"
                    Command="{Binding UnaryCommand}"
                    CommandParameter="{Binding BtnPow10Param}" />
            <Button Grid.Row="4" Grid.Column="1" Text="4"
                    Style="{StaticResource NumberButtonStyle}"
                    Command="{Binding InputDigitCommand}" CommandParameter="4" />
            <Button Grid.Row="4" Grid.Column="2" Text="5"
                    Style="{StaticResource NumberButtonStyle}"
                    Command="{Binding InputDigitCommand}" CommandParameter="5" />
            <Button Grid.Row="4" Grid.Column="3" Text="6"
                    Style="{StaticResource NumberButtonStyle}"
                    Command="{Binding InputDigitCommand}" CommandParameter="6" />
            <Button Grid.Row="4" Grid.Column="4" Text="−"
                    Style="{StaticResource OperatorButtonStyle}"
                    Command="{Binding OperationCommand}" CommandParameter="-" />

            <!-- Row 5: log  1  2  3  + -->
            <Button Grid.Row="5" Grid.Column="0"
                    Text="{Binding BtnLogText}"
                    Style="{StaticResource ScientificFunctionButtonStyle}"
                    Command="{Binding UnaryCommand}"
                    CommandParameter="{Binding BtnLogParam}" />
            <Button Grid.Row="5" Grid.Column="1" Text="1"
                    Style="{StaticResource NumberButtonStyle}"
                    Command="{Binding InputDigitCommand}" CommandParameter="1" />
            <Button Grid.Row="5" Grid.Column="2" Text="2"
                    Style="{StaticResource NumberButtonStyle}"
                    Command="{Binding InputDigitCommand}" CommandParameter="2" />
            <Button Grid.Row="5" Grid.Column="3" Text="3"
                    Style="{StaticResource NumberButtonStyle}"
                    Command="{Binding InputDigitCommand}" CommandParameter="3" />
            <Button Grid.Row="5" Grid.Column="4" Text="+"
                    Style="{StaticResource OperatorButtonStyle}"
                    Command="{Binding OperationCommand}" CommandParameter="+" />

            <!-- Row 6: ln  +/−  0  .  = -->
            <Button Grid.Row="6" Grid.Column="0"
                    Text="{Binding BtnLnText}"
                    Style="{StaticResource ScientificFunctionButtonStyle}"
                    Command="{Binding UnaryCommand}"
                    CommandParameter="{Binding BtnLnParam}" />
            <Button Grid.Row="6" Grid.Column="1" Text="+/-"
                    Style="{StaticResource NumberButtonStyle}"
                    Command="{Binding NegateCommand}" />
            <Button Grid.Row="6" Grid.Column="2" Text="0"
                    Style="{StaticResource NumberButtonStyle}"
                    Command="{Binding InputDigitCommand}" CommandParameter="0" />
            <Button Grid.Row="6" Grid.Column="3" Text="."
                    Style="{StaticResource NumberButtonStyle}"
                    Command="{Binding InputDecimalCommand}" />
            <Button Grid.Row="6" Grid.Column="4" Text="="
                    Style="{StaticResource EqualsButtonStyle}"
                    Command="{Binding EqualsCommand}" />

        </Grid>
    </Grid>
</ContentPage>

