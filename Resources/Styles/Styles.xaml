<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ===== Font Families ===== -->
    <x:String x:Key="FontRegular">OpenSansRegular</x:String>
    <x:String x:Key="FontSemibold">OpenSansSemibold</x:String>

    <!-- ===== Font Sizes ===== -->
    <x:Double x:Key="FontSizeXSmall">10</x:Double>
    <x:Double x:Key="FontSizeSmall">11</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeButton">18</x:Double>
    <x:Double x:Key="FontSizeSciButton">13</x:Double>
    <x:Double x:Key="FontSizeHeader">22</x:Double>
    <x:Double x:Key="FontSizeDisplay">44</x:Double>
    <x:Double x:Key="FontSizeSciDisplay">34</x:Double>
    <x:Double x:Key="FontSizeExpression">13</x:Double>

    <!-- ===== ContentPage Implicit Style ===== -->
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource PageBgLight}, Dark={StaticResource PageBgDark}}" />
    </Style>

    <!-- ===== IMPLICIT Button Style (applies to ALL Button controls) ===== -->
    <Style TargetType="Button">
        <Setter Property="FontFamily"          Value="{StaticResource FontRegular}" />
        <Setter Property="FontSize"            Value="{StaticResource FontSizeButton}" />
        <Setter Property="CornerRadius"        Value="4" />
        <Setter Property="BorderWidth"         Value="0" />
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource NumBtnBgLight}, Dark={StaticResource NumBtnBgDark}}" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
        <Setter Property="Padding"             Value="0" />
        <Setter Property="Margin"              Value="2" />
        <Setter Property="MinimumHeightRequest" Value="40" />
        <Setter Property="MinimumWidthRequest"  Value="40" />
    </Style>

    <!-- ===== EXPLICIT BaseButtonStyle (base for BasedOn) ===== -->
    <Style x:Key="BaseButtonStyle" TargetType="Button">
        <Setter Property="FontFamily"          Value="{StaticResource FontRegular}" />
        <Setter Property="FontSize"            Value="{StaticResource FontSizeButton}" />
        <Setter Property="CornerRadius"        Value="4" />
        <Setter Property="BorderWidth"         Value="0" />
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource NumBtnBgLight}, Dark={StaticResource NumBtnBgDark}}" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
        <Setter Property="Padding"             Value="0" />
        <Setter Property="Margin"              Value="2" />
        <Setter Property="MinimumHeightRequest" Value="40" />
        <Setter Property="MinimumWidthRequest"  Value="40" />
    </Style>

    <!-- ===== NumberButtonStyle  (BasedOn BaseButtonStyle) ===== -->
    <Style x:Key="NumberButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="FontFamily"     Value="{StaticResource FontSemibold}" />
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource NumBtnBgLight}, Dark={StaticResource NumBtnBgDark}}" />
    </Style>

    <!-- ===== OperatorButtonStyle  (BasedOn BaseButtonStyle) ===== -->
    <Style x:Key="OperatorButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource OpBtnBgLight}, Dark={StaticResource OpBtnBgDark}}" />
    </Style>

    <!-- ===== EqualsButtonStyle  (BasedOn BaseButtonStyle) ===== -->
    <Style x:Key="EqualsButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="FontFamily" Value="{StaticResource FontSemibold}" />
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource EqualsBtnBgLight}, Dark={StaticResource EqualsBtnBgDark}}" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource EqualsBtnTextLight}, Dark={StaticResource EqualsBtnTextDark}}" />
    </Style>

    <!-- ===== MemoryButtonStyle  (BasedOn BaseButtonStyle) ===== -->
    <Style x:Key="MemoryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="FontSize"       Value="{StaticResource FontSizeSmall}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource MemBtnTextLight}, Dark={StaticResource MemBtnTextDark}}" />
        <Setter Property="HeightRequest"  Value="32" />
        <Setter Property="Margin"         Value="1" />
    </Style>

    <!-- ===== ScientificFunctionButtonStyle  (BasedOn BaseButtonStyle) ===== -->
    <Style x:Key="ScientificFunctionButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="FontSize"       Value="{StaticResource FontSizeSciButton}" />
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource SciFuncBtnBgLight}, Dark={StaticResource SciFuncBtnBgDark}}" />
    </Style>

    <!-- ===== AngleModeButtonStyle  (BasedOn BaseButtonStyle) ===== -->
    <Style x:Key="AngleModeButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="FontSize"        Value="{StaticResource FontSizeSmall}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
        <Setter Property="HeightRequest"   Value="30" />
        <Setter Property="Margin"          Value="2,1" />
    </Style>

    <!-- ===== DropdownButtonStyle  (BasedOn BaseButtonStyle) ===== -->
    <Style x:Key="DropdownButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="FontSize"        Value="{StaticResource FontSizeBody}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
        <Setter Property="HeightRequest"   Value="34" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>

    <!-- ===== LABEL STYLES ===== -->

    <!-- Main display number -->
    <Style x:Key="DisplayPrimaryStyle" TargetType="Label">
        <Setter Property="FontFamily"          Value="{StaticResource FontSemibold}" />
        <Setter Property="FontSize"            Value="{StaticResource FontSizeDisplay}" />
        <Setter Property="HorizontalTextAlignment" Value="End" />
        <Setter Property="VerticalTextAlignment"   Value="End" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
        <Setter Property="LineBreakMode" Value="NoWrap" />
        <Setter Property="MaxLines"      Value="1" />
    </Style>

    <!-- Scientific display number (smaller) -->
    <Style x:Key="DisplaySciPrimaryStyle" TargetType="Label">
        <Setter Property="FontFamily"          Value="{StaticResource FontSemibold}" />
        <Setter Property="FontSize"            Value="{StaticResource FontSizeSciDisplay}" />
        <Setter Property="HorizontalTextAlignment" Value="End" />
        <Setter Property="VerticalTextAlignment"   Value="End" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
        <Setter Property="LineBreakMode" Value="NoWrap" />
        <Setter Property="MaxLines"      Value="1" />
    </Style>

    <!-- Expression / history -->
    <Style x:Key="DisplayExpressionStyle" TargetType="Label">
        <Setter Property="FontFamily"          Value="{StaticResource FontRegular}" />
        <Setter Property="FontSize"            Value="{StaticResource FontSizeExpression}" />
        <Setter Property="HorizontalTextAlignment" Value="End" />
        <Setter Property="VerticalTextAlignment"   Value="End" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="MaxLines"      Value="1" />
    </Style>

    <!-- Page title -->
    <Style x:Key="PageTitleStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontSemibold}" />
        <Setter Property="FontSize"   Value="{StaticResource FontSizeHeader}" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
    </Style>

    <!-- Settings section header -->
    <Style x:Key="SettingsSectionStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontSemibold}" />
        <Setter Property="FontSize"   Value="{StaticResource FontSizeBody}" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- Settings description text -->
    <Style x:Key="SettingsDescStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontRegular}" />
        <Setter Property="FontSize"   Value="{StaticResource FontSizeSmall}" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- Settings card border -->
    <Style x:Key="SettingsCardStyle" TargetType="Border">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}" />
        <Setter Property="Stroke"
                Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape"     Value="RoundRectangle 8" />
        <Setter Property="Padding"  Value="16" />
        <Setter Property="Margin"   Value="0,6" />
    </Style>

    <!-- RadioButton -->
    <Style TargetType="RadioButton">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
        <Setter Property="FontFamily" Value="{StaticResource FontRegular}" />
        <Setter Property="FontSize"   Value="{StaticResource FontSizeBody}" />
        <Setter Property="Margin"     Value="0,4" />
    </Style>

</ResourceDictionary>
